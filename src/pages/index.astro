<script>
  // ── Contact modal ──
  const modal    = document.getElementById('contact-modal') as HTMLElement;
  const card     = document.getElementById('contact-card') as HTMLElement;
  const backdrop = document.getElementById('contact-backdrop');
  const closeBtn = document.getElementById('contact-close');
  const toast    = document.getElementById('copy-toast') as HTMLElement;

  function openModal() {
    modal.style.visibility = 'visible';
    modal.style.pointerEvents = 'auto';
    // Trigger transition on next frame so visibility is painted first
    requestAnimationFrame(() => {
      modal.style.opacity = '1';
      card.style.opacity = '1';
      card.style.transform = 'translateY(0)';
    });
  }
  function closeModal() {
    modal.style.opacity = '0';
    modal.style.pointerEvents = 'none';
    card.style.opacity = '0';
    card.style.transform = 'translateY(32px)';
    setTimeout(() => { modal.style.visibility = 'hidden'; }, 300);
  }

  document.querySelectorAll('[data-open-contact]').forEach(el =>
    el.addEventListener('click', openModal)
  );
  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });

  document.getElementById('discord-copy-btn')?.addEventListener('click', () => {
    navigator.clipboard.writeText('.ehlan').then(() => {
      toast.style.opacity = '1';
      toast.style.transform = 'translate(-50%, 0)';
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translate(-50%, 8px)';
      }, 2200);
    });
  });
</script>
