---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import ThreeScene from '../components/3D/ThreeScene.svelte';
import HeroCanvas from '../components/3D/HeroCanvas.svelte';
---

<BaseLayout title="Jaelan Cruz | Software Engineer">
  <Navigation />
  
  <!-- Hero Section -->
  <section class="min-h-screen flex items-center justify-center relative overflow-hidden">
    <!-- 3D Background Canvas -->
    <div class="absolute inset-0 -z-10">
      <HeroCanvas client:load />
    </div>
    
    <!-- Gradient overlay for better text contrast -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/50 via-transparent to-black/70 -z-5"></div>
    
    <div class="max-w-7xl mx-auto px-6 py-32 relative z-10">
      <div class="text-left max-w-3xl space-y-6">
        <h1 class="hero-title text-6xl md:text-7xl lg:text-8xl font-bold tracking-tight leading-tight">
          Jaelan <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 to-accent-200">Cruz</span>
        </h1>
        <p class="hero-subtitle text-2xl md:text-3xl text-accent-300 font-medium">
          Full-Stack & Cloud Engineer
        </p>
        <p class="hero-description text-base md:text-lg text-gray-400 max-w-xl leading-relaxed">
          Software engineering student building full-stack applications<br />
          and cloud-native solutions with modern web technologies
        </p>
        
        <div class="hero-buttons flex items-center gap-4 pt-6">
          <a href="#about" class="px-8 py-3 bg-accent-400 text-black rounded-lg hover:bg-accent-300 transition-all hover:shadow-xl hover:shadow-accent-400/30 font-medium">
            Explore My Work
          </a>
          <a href="#projects" class="px-8 py-3 border-2 border-accent-400 text-accent-400 rounded-lg hover:bg-accent-400/10 transition-all font-medium">
            View Projects
          </a>
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- About Section -->
  <section id="about" class="min-h-screen flex items-center py-20 bg-gradient-to-b from-black via-gray-900/50 to-black">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="animate-about space-y-8">
          <div>
            <h2 class="text-5xl font-bold mb-4">
              About <span class="text-accent-400">Me</span>
            </h2>
            <p class="text-lg text-gray-300 leading-relaxed mb-2">
              Full-Stack & Cloud Engineer<br />
              Software engineering student building full-stack applications<br />
              and cloud-native solutions with modern web technologies
            </p>
          </div>
          <hr class="border-accent-400/30 my-6">
          <div>
            <h3 class="text-2xl font-semibold text-accent-400 mb-2">Education</h3>
            <p class="text-lg font-semibold text-white">York University</p>
            <p class="text-gray-300">Bachelor of Applied Science • Expected Apr. 2028</p>
            <p class="text-sm text-gray-400 mt-2">Relevant Coursework: Data Structures & Algorithms, User Interfaces, Software Design, Object-Oriented Programming, Intro to Cloud</p>
          </div>
        </div>
        <div class="h-96">
          <div class="h-full bg-gradient-to-br from-accent-400/10 to-accent-600/10 rounded-2xl border border-accent-400/20 p-8 flex flex-col justify-between">
            <div id="about-stats" class="grid grid-cols-2 gap-4">
              <div class="text-center p-4 rounded-xl bg-black/40 border border-accent-400/10">
                <div class="text-4xl font-bold text-accent-400" data-count="8" data-suffix="">0</div>
                <div class="text-sm text-gray-400 mt-1">Languages</div>
              </div>
              <div class="text-center p-4 rounded-xl bg-black/40 border border-accent-400/10">
                <div class="text-4xl font-bold text-accent-400" data-count="10" data-suffix="+">0</div>
                <div class="text-sm text-gray-400 mt-1">Frameworks</div>
              </div>
              <div class="text-center p-4 rounded-xl bg-black/40 border border-accent-400/10">
                <div class="text-4xl font-bold text-accent-400" data-count="0" data-suffix="" data-stat="contributions">—</div>
                <div class="text-sm text-gray-400 mt-1">GitHub Contributions</div>
              </div>
              <div class="text-center p-4 rounded-xl bg-black/40 border border-accent-400/10">
                <div class="text-4xl font-bold text-accent-400" data-count="20" data-suffix="+">0</div>
                <div class="text-sm text-gray-400 mt-1">Technologies Used</div>
              </div>
            </div>
            <div class="space-y-3">
              <div class="flex items-center gap-3 text-sm text-gray-300">
                <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse flex-shrink-0"></span>
                <span>Fullstack Engineer at <span class="font-semibold text-white">Circe</span></span>
              </div>
              <div class="flex items-center gap-3 text-sm text-gray-300">
                <span class="w-2 h-2 rounded-full bg-accent-400 flex-shrink-0"></span>
                <span>BASc Computer Science (CSSD) · <span class="font-semibold text-white">York University</span> '28</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section id="skills" class="min-h-screen flex items-center py-20 bg-black">
    <div class="max-w-7xl mx-auto px-6 w-full">
      <h2 class="animate-heading text-5xl font-bold text-center mb-16">
        Technical <span class="text-accent-400">Skills</span>
      </h2>
      
      <div class="animate-cards grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        <!-- Programming Languages -->
        <div class="animate-card group p-6 rounded-2xl bg-gray-900/50 border-2 border-gray-800 hover:border-accent-400 transition-all hover:shadow-xl hover:shadow-accent-400/10 backdrop-blur-sm">
            <div class="w-12 h-12 bg-accent-400/10 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3 text-white">Languages</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Java • Python • C • JavaScript • TypeScript • HTML5 • CSS • Bash
            </p>
          </div>

          <!-- Frameworks -->
          <div class="animate-card group p-6 rounded-2xl bg-gray-900/50 border-2 border-gray-800 hover:border-accent-400 transition-all hover:shadow-xl hover:shadow-accent-400/10 backdrop-blur-sm">
            <div class="w-12 h-12 bg-accent-400/10 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3 text-white">Frameworks</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              React • FastAPI • Astro • Svelte • Three.js • Flask • TailwindCSS • Formik • Yup • Jinja2
            </p>
          </div>

          <!-- Databases -->
          <div class="animate-card group p-6 rounded-2xl bg-gray-900/50 border-2 border-gray-800 hover:border-accent-400 transition-all hover:shadow-xl hover:shadow-accent-400/10 backdrop-blur-sm">
            <div class="w-12 h-12 bg-accent-400/10 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3 text-white">Databases</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              PostgreSQL
            </p>
          </div>

          <!-- Tools & APIs -->
          <div class="animate-card group p-6 rounded-2xl bg-gray-900/50 border-2 border-gray-800 hover:border-accent-400 transition-all hover:shadow-xl hover:shadow-accent-400/10 backdrop-blur-sm">
            <div class="w-12 h-12 bg-accent-400/10 rounded-lg flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3 text-white">Tools & Platforms</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              Git • GitHub • AWS • Docker • VS Code • Linux • GitHub Actions
            </p>
            <h3 class="text-xl font-semibold mb-3 text-white mt-6">AI & Automation</h3>
            <p class="text-gray-400 text-sm leading-relaxed">
              GPT-4o • Claude Sonnet 3.5 • Copilot
            </p>
          </div>
        </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="min-h-screen flex items-center py-20 bg-gradient-to-b from-black via-gray-900/30 to-black">
    <div class="max-w-5xl mx-auto px-6 w-full">
      <h2 class="animate-heading text-5xl font-bold text-center mb-16">
        Work <span class="text-accent-400">Experience</span>
      </h2>
      
      <div class="relative">
        <!-- Timeline line -->
        <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-0.5 bg-accent-400/30 transform md:-translate-x-1/2"></div>
        
        <!-- Experience Item -->
        <div class="animate-timeline mb-8 flex flex-col md:flex-row items-start md:items-center w-full">
            <div class="md:w-5/12 md:text-right mb-4 md:mb-0 md:pr-8">
              <h3 class="text-2xl font-bold text-white">Fullstack Engineer</h3>
              <p class="text-accent-400 font-semibold">Circe</p>
              <p class="text-sm text-gray-400">Contract Part-Time</p>
            </div>
            
            <div class="relative md:w-2/12 flex justify-start md:justify-center mb-4 md:mb-0">
              <div class="w-4 h-4 bg-accent-400 rounded-full border-4 border-black shadow-lg shadow-accent-400/50"></div>
            </div>
            
            <div class="md:w-5/12 md:pl-8">
              <p class="text-sm text-gray-400 font-medium mb-3">Dec 2025 – Present</p>
              <ul class="space-y-2 text-gray-300">
                <li class="flex items-start gap-2"><span class="text-accent-400 mt-1.5">•</span><span class="text-sm">Collaborated with a team of <span class="font-bold">6+ contributors</span> on a production <span class="font-bold">React Native</span> app, resolving merge conflicts and maintaining code quality across branches.</span></li>
                <li class="flex items-start gap-2"><span class="text-accent-400 mt-1.5">•</span><span class="text-sm">Built and hardened <span class="font-bold">user profile and preferences</span> REST API with <span class="font-bold">FastAPI</span> and <span class="font-bold">PostgreSQL</span> — implemented JSONB storage, <span class="font-bold">Cognito JWT</span> auth, payload size limits, and <span class="font-bold">SQL validation triggers</span>.</span></li>
                <li class="flex items-start gap-2"><span class="text-accent-400 mt-1.5">•</span><span class="text-sm">Coupled client-side software to internal systems via a <span class="font-bold">TypeScript</span> API client and custom <span class="font-bold">React hooks</span>, handling loading, error, and update states end-to-end.</span></li>
                <li class="flex items-start gap-2"><span class="text-accent-400 mt-1.5">•</span><span class="text-sm">Engineered <span class="font-bold">5 authentication flows</span> (sign-in, sign-up, confirmation, password reset, forgot password) with robust validation, a <span class="font-bold">password strength meter</span>, and real-time error messaging.</span></li>
                <li class="flex items-start gap-2"><span class="text-accent-400 mt-1.5">•</span><span class="text-sm">Refactored core user-facing features across <span class="font-bold">8+ files</span> (<span class="font-bold">1,000+ lines</span> changed), reducing duplication and improving long-term maintainability.</span></li>
              </ul>
            </div>
          </div>
        </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="min-h-screen flex items-center py-20 bg-black">
    <div class="max-w-7xl mx-auto px-6 w-full">
      <h2 class="animate-heading text-5xl font-bold text-center mb-16">
        Featured <span class="text-accent-400">Projects</span>
      </h2>
        
        <div class="grid md:grid-cols-2 gap-8">
          <!-- Project: jamSpace -->
          <div class="animate-project group relative overflow-hidden rounded-2xl bg-gray-900/50 border-2 border-gray-800 hover:border-accent-400 transition-all hover:shadow-2xl hover:shadow-accent-400/20 backdrop-blur-sm">
            <div class="absolute top-0 right-0 w-32 h-32 -mr-16 -mt-16 opacity-10">
              <ThreeScene type="sphere" color="#0ea5e9" animate={false} client:visible />
            </div>
            
            <div class="p-8 relative z-10">
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-2xl font-bold text-white group-hover:text-accent-400 transition-colors">jamSpace</h3>
                <span class="text-xs bg-accent-400/10 text-accent-400 px-3 py-1 rounded-full font-medium border border-accent-400/20">Jun 2025 – Present</span>
              </div>
              <p class="text-gray-300 mb-4">
                Developed a full-stack productivity web application using <span class="font-bold">Flask</span> with a modular <span class="font-bold">Blueprint architecture</span> for scalable route management.
              </p>
              <ul class="space-y-2 text-gray-400 mb-6">
                <li class="flex items-start gap-2">
                  <span class="text-accent-400 mt-0.5">✓</span>
                  <span>Refactored and unified over <span class="font-bold">600 lines</span> of legacy calendar code, merging weekly and monthly views into a single, maintainable planner.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent-400 mt-0.5">✓</span>
                  <span>Removed <span class="font-bold">5+ obsolete files</span> and reduced codebase clutter by over <span class="font-bold">1,000 lines</span> through systematic cleanup and reorganization.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent-400 mt-0.5">✓</span>
                  <span>Enhanced <span class="font-bold">UI/UX</span> with <span class="font-bold">300+ lines</span> of custom CSS and JavaScript for responsive design, modals, and advanced animations.</span>
                </li>
              </ul>
              <div class="flex gap-3">
                <a href="https://github.com/mxta-o" class="flex items-center gap-2 text-sm text-accent-400 hover:text-accent-300 font-medium transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                  View Repository
                </a>
              </div>
            </div>
          </div>

          <!-- Project: PixelCraft -->
          <div class="animate-project group relative overflow-hidden rounded-2xl bg-gray-900/50 border-2 border-gray-800 hover:border-accent-400 transition-all hover:shadow-2xl hover:shadow-accent-400/20 backdrop-blur-sm">
            <div class="absolute top-0 right-0 w-32 h-32 -mr-16 -mt-16 opacity-10">
              <ThreeScene type="cube" color="#0ea5e9" animate={false} client:visible />
            </div>
            <div class="p-8 relative z-10">
              <div class="flex items-start justify-between mb-4">
                <h3 class="text-2xl font-bold text-white group-hover:text-accent-400 transition-colors">PixelCraft</h3>
                <span class="text-xs bg-accent-400/10 text-accent-400 px-3 py-1 rounded-full font-medium border border-accent-400/20">2025</span>
              </div>
              <p class="text-gray-300 mb-4">
                Developed a modular image processing tool supporting batch transformations with <span class="font-bold">8+ filters</span> (grayscale, blur, flip, high contrast, negative, red channel, rotate, vibrancy), processing <span class="font-bold">1,000+ images</span> in testing.
              </p>
              <ul class="space-y-2 text-gray-400 mb-6">
                <li class="flex items-start gap-2">
                  <span class="text-accent-400 mt-0.5">✓</span>
                  <span>Designed extensible <span class="font-bold">OOP</span> architecture using <span class="font-bold">Java Reflection</span> for dynamic filter selection and rapid addition of new effects.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent-400 mt-0.5">✓</span>
                  <span>Implemented a <span class="font-bold">command-line interface</span> and <span class="font-bold">10+ Bash scripts</span> for flexible usage and <span class="font-bold">100% automated batch workflows</span>.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-accent-400 mt-0.5">✓</span>
                  <span>Processed <span class="font-bold">PNG images</span> and automated file management for efficient, large-scale operations.</span>
                </li>
              </ul>
              <div class="flex gap-3">
                <a href="https://github.com/mxta-o/PixelCraft" class="flex items-center gap-2 text-sm text-accent-400 hover:text-accent-300 font-medium transition-colors">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                  View Repository
                </a>
              </div>
            </div>
          </div>

          <!-- Placeholder for future project -->
          <div class="animate-project group relative overflow-hidden rounded-2xl bg-gradient-to-br from-gray-900/30 to-gray-900/50 border-2 border-dashed border-gray-700 hover:border-accent-400/50 transition-all backdrop-blur-sm">
            <div class="p-8 flex flex-col items-center justify-center h-full text-center min-h-[400px]">
              <div class="w-16 h-16 bg-accent-400/10 rounded-full flex items-center justify-center mb-4 border border-accent-400/20">
                <svg class="w-8 h-8 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
              </div>
              <h3 class="text-xl font-semibold text-gray-300 mb-2">More Projects Coming Soon</h3>
              <p class="text-gray-400 text-sm">Currently building amazing things</p>
            </div>
          </div>
        </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gradient-to-b from-black to-gray-950 text-white py-12 border-t border-gray-800">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-center md:text-left">
          <h3 class="text-2xl font-bold mb-2">Let's Build Something Together</h3>
          <p class="text-gray-400">Open to opportunities and collaborations</p>
        </div>
        
        <button data-open-contact class="px-6 py-3 bg-accent-400 text-black rounded-lg hover:bg-accent-300 transition-all hover:shadow-xl hover:shadow-accent-400/30 font-medium">
          Get in Touch
        </button>
      </div>
      
      <div class="mt-8 pt-8 border-t border-gray-800 text-center text-gray-400 text-sm">
        <p>© 2026 Jaelan Cruz. Built with Astro, Svelte, Three.js & Tailwind CSS.</p>
