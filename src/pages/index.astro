---
import OmoriLayout from '../layouts/OmoriLayout.astro';
import DialogueBox from '../components/DialogueBox.astro';
import Portrait from '../components/Portrait.astro';
import EnergyMeter from '../components/EnergyMeter.astro';
import MenuButton from '../components/MenuButton.astro';
import OmoriNavigation from '../components/OmoriNavigation.astro';
import CharacterSprite from '../components/CharacterSprite.astro';
import SkillsShowcase from '../components/SkillsShowcase.astro';
import ProjectCard from '../components/ProjectCard.astro';

const skillsData = [
  { name: 'React', level: 95, category: 'Frontend' },
  { name: 'TypeScript', level: 90, category: 'Frontend' },
  { name: 'Python', level: 90, category: 'Backend' },
  { name: 'Flask', level: 85, category: 'Backend' },
  { name: 'UI/UX Design', level: 88, category: 'Design' },
  { name: 'TailwindCSS', level: 92, category: 'Frontend' },
  { name: 'REST APIs', level: 85, category: 'Backend' },
  { name: 'Git', level: 88, category: 'Tools' },
];
---

<OmoriLayout title="Jaelan Cruz | Software Engineer Portfolio">
  <!-- OMORI Navigation -->
  <OmoriNavigation />

  <main class="min-h-screen bg-omori-white p-4 md:p-8 lg:p-16">
    
    <!-- Decorative header banner -->
    <div class="max-w-6xl mx-auto mb-8">
      <div class="border-4 border-black bg-white p-4 text-center sketch-border">
        <p class="font-mono text-sm">WELCOME TO THE PORTFOLIO</p>
        <div class="flex justify-center gap-4 mt-2">
          <CharacterSprite character="sunny" size="small" />
          <CharacterSprite character="aubrey" size="small" />
          <CharacterSprite character="kel" size="small" />
          <CharacterSprite character="basil" size="small" />
        </div>
      </div>
    </div>

    <!-- Hero Section with Character Portrait -->
    <section id="about" class="max-w-6xl mx-auto mb-20 animate-fade-in">
      <div class="grid md:grid-cols-3 gap-8 items-start">
        <!-- Character Portrait -->
        <div class="flex justify-center md:justify-start mb-8">
          <Portrait 
            name="Jaelan Cruz" 
            role="Software Engineer"
          />
        </div>
        
        <!-- Main Info Dialogue Box -->
        <div class="md:col-span-2">
          <DialogueBox title="Welcome to my world!" variant="default" animate={true}>
            <div class="space-y-4">
              <p class="text-3xl font-bold uppercase tracking-wider mb-2">Jaelan Cruz</p>
              <p class="text-xl border-l-4 border-black pl-4">Frontend UI/UX Engineer</p>
              
              <div class="my-6 p-4 bg-gray-100 border-2 border-black">
                <p class="leading-relaxed">
                  Software engineering student at <strong>York University</strong> with hands-on experience in full-stack web development. 
                  Currently Frontend UI/UX Engineer at <strong>Circe</strong>, designing React and TypeScript components while expanding 
                  into backend development with Python.
                </p>
              </div>

              <!-- Energy Meters for Quick Stats -->
              <div class="mt-6 space-y-2">
                <p class="text-sm uppercase tracking-wider font-bold mb-3">⚡ Core Competencies</p>
                <EnergyMeter name="React & TypeScript" current={95} max={100} color="energy" />
                <EnergyMeter name="Python & Flask" current={90} max={100} color="energy" />
                <EnergyMeter name="UI/UX Design" current={88} max={100} color="energy" />
                <EnergyMeter name="Full-Stack Dev" current={85} max={100} color="energy" />
              </div>

              <!-- Contact Info -->
              <div class="mt-6 pt-6 border-t-3 border-black space-y-3">
                <p class="flex items-center gap-3 hover:translate-x-2 transition-transform">
                  <span class="text-xl">📧</span>
                  <a href="mailto:jaelancruz@yahoo.com" class="hover:underline font-mono">jaelancruz@yahoo.com</a>
                </p>
                <p class="flex items-center gap-3 hover:translate-x-2 transition-transform">
                  <span class="text-xl">📱</span>
                  <span class="font-mono">+1 437-254-5596</span>
                </p>
                <p class="flex items-center gap-3 hover:translate-x-2 transition-transform">
                  <span class="text-xl">🔗</span>
                  <a href="https://linkedin.com/in/jaelan-cruz" target="_blank" class="hover:underline font-mono">LinkedIn</a>
                  <span class="mx-2">•</span>
                  <a href="https://github.com/mxta-o" target="_blank" class="hover:underline font-mono">GitHub</a>
                </p>
              </div>
            </div>
          </DialogueBox>
        </div>
      </div>
    </section>

    <!-- Education Section -->
    <section id="education" class="max-w-6xl mx-auto mb-20 animate-slide-up">
      <DialogueBox title="📚 Education" variant="headspace">
        <div class="grid md:grid-cols-2 gap-6">
          <!-- Main education info -->
          <div>
            <div class="border-l-4 border-black pl-4">
              <h3 class="text-2xl font-bold uppercase mb-2">York University</h3>
              <p class="text-lg mb-1">Bachelor of Applied Science</p>
              <p class="text-sm text-gray-700 mb-2">📍 Markham, ON</p>
              <p class="font-mono text-sm">⏱️ Expected Apr. 2028</p>
            </div>
          </div>
          
          <!-- Coursework -->
          <div>
            <p class="font-bold mb-3 uppercase text-sm tracking-wider">📖 Relevant Coursework:</p>
            <div class="grid grid-cols-2 gap-2">
              <div class="dialogue-box text-xs px-2 py-2">Data Structures & Algorithms</div>
              <div class="dialogue-box text-xs px-2 py-2">User Interfaces</div>
              <div class="dialogue-box text-xs px-2 py-2">Software Design</div>
              <div class="dialogue-box text-xs px-2 py-2">OOP</div>
              <div class="dialogue-box text-xs px-2 py-2 md:col-span-2">Intro to Cloud</div>
            </div>
          </div>
        </div>
      </DialogueBox>
    </section>

    <!-- Experience Section -->
    <section id="experience" class="max-w-6xl mx-auto mb-20 animate-slide-up">
      <DialogueBox title="💼 Experience" variant="default">
        <div class="space-y-6">
          <!-- Circe Position -->
          <div class="relative">
            <!-- Position header -->
            <div class="bg-black text-white p-4 mb-4">
              <div class="flex justify-between items-start flex-wrap gap-2">
                <div>
                  <h3 class="text-xl font-bold uppercase mb-1">Frontend UI/UX Engineer</h3>
                  <p class="text-sm">Circe – Contract Part-Time</p>
                </div>
                <span class="font-mono text-sm bg-white text-black px-3 py-1">Dec 2025 - Present</span>
              </div>
            </div>
            
            <!-- Responsibilities -->
            <div class="space-y-3 pl-4 border-l-4 border-black">
              <div class="flex gap-3 group hover:translate-x-2 transition-transform">
                <span class="text-xl mt-1">▶</span>
                <p>Engineered <strong>authentication interface</strong> for Saga web application using <strong>React</strong> and 
                <strong>TypeScript</strong> with <strong>Formik</strong> and <strong>Yup</strong> for robust form validation and error handling</p>
              </div>
              <div class="flex gap-3 group hover:translate-x-2 transition-transform">
                <span class="text-xl mt-1">▶</span>
                <p>Architecting <strong>file upload functionality</strong> to enhance content management capabilities and streamline 
                user workflows within the platform</p>
              </div>
              <div class="flex gap-3 group hover:translate-x-2 transition-transform">
                <span class="text-xl mt-1">▶</span>
                <p>Collaborating with cross-functional team of <strong>engineers and product managers</strong> to transform 
                early-stage concepts into production-ready features</p>
              </div>
              <div class="flex gap-3 group hover:translate-x-2 transition-transform">
                <span class="text-xl mt-1">▶</span>
                <p>Expanding technical scope toward <strong>Python backend development</strong> and <strong>RESTful API integration</strong> 
                to support full-stack feature implementation</p>
              </div>
            </div>
          </div>
        </div>
      </DialogueBox>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="max-w-6xl mx-auto mb-20 animate-slide-up">
      <div class="mb-8">
        <h2 class="text-4xl font-bold uppercase mb-2 flex items-center gap-3">
          <span class="text-5xl">📁</span>
          Projects
        </h2>
      </div>
      
      <ProjectCard 
        name="jamSpace"
        description="A full-stack productivity web application featuring Pomodoro Timer, Habit Tracker, Focus Logger, and Time Capsule with persistent data storage."
        technologies={['Python', 'Flask', 'HTML', 'CSS', 'JavaScript', 'JSON']}
        highlights={[
          'Developed using Flask with modular Blueprint architecture for scalable route management',
          'Implemented 4 productivity tools with persistent JSON-based data storage',
          'Built CRUD functionality for habit tracking with date-based completion tracking',
          'Designed responsive UI templates using Jinja2 with custom CSS animations and dynamic validation'
        ]}
        date="Jun. 2025 - Present"
      />
    </section>

    <!-- Technical Skills Section -->
    <section id="skills" class="max-w-6xl mx-auto mb-20 animate-slide-up">
      <DialogueBox title="⚡ Technical Skills" variant="default">
        <SkillsShowcase skills={skillsData} />
        
        <!-- Additional Tech Stack Lists -->
        <div class="mt-8 pt-8 border-t-3 border-black">
          <div class="grid md:grid-cols-2 gap-8">
            <!-- Programming Languages -->
            <div>
              <h4 class="font-bold text-lg mb-3 uppercase flex items-center gap-2">
                <span>💻</span> Programming Languages
              </h4>
              <div class="flex flex-wrap gap-2">
                {['Java', 'Python', 'C', 'C++', 'JavaScript', 'TypeScript', 'Assembly', 'HTML5', 'CSS'].map((lang) => (
                  <span class="dialogue-box text-sm px-3 py-1 hover:bg-black hover:text-white transition-colors cursor-default">{lang}</span>
                ))}
              </div>
            </div>

            <!-- Frameworks & Tools -->
            <div>
              <h4 class="font-bold text-lg mb-3 uppercase flex items-center gap-2">
                <span>🛠️</span> Frameworks & Tools
              </h4>
              <div class="flex flex-wrap gap-2">
                {['React', 'Flask', 'TailwindCSS', 'Formik', 'Yup', 'Jinja2', 'Git', 'GitHub', 'AWS', 'REST APIs'].map((tool) => (
                  <span class="dialogue-box text-sm px-3 py-1 hover:bg-black hover:text-white transition-colors cursor-default">{tool}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </DialogueBox>
    </section>

    <!-- Contact/Action Section -->
    <section id="contact" class="max-w-6xl mx-auto mb-20">
      <DialogueBox title="Let's Connect!" variant="serious">
        <p class="mb-6 text-lg">Ready to collaborate or learn more? Choose your next action:</p>
        
        <div class="grid md:grid-cols-3 gap-4">
          <a href="mailto:jaelancruz@yahoo.com">
            <MenuButton label="Send Email" variant="fight" selected={false} />
          </a>
          <a href="https://github.com/mxta-o" target="_blank">
            <MenuButton label="View GitHub" variant="skill" selected={false} />
          </a>
          <a href="https://linkedin.com/in/jaelan-cruz" target="_blank">
            <MenuButton label="Connect on LinkedIn" variant="snack" selected={false} />
          </a>
        </div>
      </DialogueBox>
    </section>

    <!-- Footer -->
    <footer class="max-w-6xl mx-auto mt-20 pt-8 border-t-4 border-black">
      <div class="dialogue-box text-center">
        <p class="font-mono text-sm mb-2">© 2026 Jaelan Cruz</p>
        <p class="text-xs text-gray-600">Built with OMORI aesthetics & modern web technologies</p>
        <div class="mt-4 flex justify-center gap-4">
          <CharacterSprite character="omori" size="small" />
        </div>
        <p class="font-mono text-xs mt-4 animate-blink">▶ Press [SPACE] to continue...</p>
      </div>
    </footer>
  </main>
</OmoriLayout>

<style>
  /* Parallax scroll effect */
  @media (prefers-reduced-motion: no-preference) {
    section {
      scroll-margin-top: 2rem;
    }
  }

  /* Hand-drawn line decorations */
  .sketch-line {
    background-image: repeating-linear-gradient(
      90deg,
      black 0px,
      black 10px,
      transparent 10px,
      transparent 20px
    );
    height: 3px;
  }

  /* Typewriter effect for headings */
  @keyframes typewriter {
    from { width: 0; }
    to { width: 100%; }
  }
</style>
