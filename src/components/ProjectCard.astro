---
interface Props {
  name: string;
  description: string;
  technologies: string[];
  highlights: string[];
  date: string;
}

const { name, description, technologies, highlights, date } = Astro.props;
---

<div class="project-card bg-white border-4 border-black p-6 mb-6 sketch-border hover:animate-wiggle">
  <!-- Project Header -->
  <div class="flex justify-between items-start mb-4 pb-3 border-b-3 border-black">
    <h3 class="text-2xl font-bold uppercase tracking-wide flex items-center gap-2">
      <span class="text-3xl">📁</span>
      {name}
    </h3>
    <span class="font-mono text-sm whitespace-nowrap ml-4">{date}</span>
  </div>

  <!-- Description -->
  <p class="mb-4 leading-relaxed">{description}</p>

  <!-- Technologies -->
  <div class="mb-4">
    <p class="text-xs uppercase tracking-wider font-bold mb-2">Tech Stack:</p>
    <div class="flex flex-wrap gap-2">
      {technologies.map((tech) => (
        <span class="px-3 py-1 bg-black text-white text-xs font-mono uppercase border-2 border-black hover:bg-white hover:text-black transition-colors">
          {tech}
        </span>
      ))}
    </div>
  </div>

  <!-- Highlights -->
  <div class="space-y-2">
    {highlights.map((highlight) => (
      <div class="flex gap-2 items-start">
        <span class="mt-1 text-sm">▶</span>
        <p class="text-sm leading-relaxed">{highlight}</p>
      </div>
    ))}
  </div>

  <!-- Decorative corner -->
  <div class="absolute top-2 right-2 w-4 h-4 border-t-2 border-r-2 border-black"></div>
  <div class="absolute bottom-2 left-2 w-4 h-4 border-b-2 border-l-2 border-black"></div>
</div>

<style>
  .project-card {
    position: relative;
    transition: all 0.2s ease;
    box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.2);
  }

  .project-card:hover {
    box-shadow: 8px 8px 0px rgba(0, 0, 0, 0.3);
    transform: translate(-2px, -2px);
  }
</style>
