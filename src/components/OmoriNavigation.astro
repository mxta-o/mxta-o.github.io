---
// OMORI-themed navigation menu
const navItems = [
  { label: 'About', href: '#about', icon: '👤' },
  { label: 'Education', href: '#education', icon: '📚' },
  { label: 'Experience', href: '#experience', icon: '💼' },
  { label: 'Projects', href: '#projects', icon: '📁' },
  { label: 'Skills', href: '#skills', icon: '⚡' },
  { label: 'Contact', href: '#contact', icon: '📧' }
];
---

<nav class="omori-menu fixed top-8 right-8 z-50">
  <!-- Menu toggle button -->
  <input type="checkbox" id="menu-toggle" class="hidden peer" />
  <label 
    for="menu-toggle" 
    class="menu-button bg-white border-4 border-black px-4 py-3 cursor-pointer flex items-center gap-2 hover:bg-black hover:text-white transition-colors"
  >
    <span class="text-xl">☰</span>
    <span class="font-bold uppercase text-sm">Menu</span>
  </label>

  <!-- Menu items -->
  <div class="menu-items hidden peer-checked:block absolute top-full right-0 mt-4 min-w-[200px]">
    <div class="bg-white border-4 border-black p-2 space-y-2 sketch-border">
      {navItems.map((item, index) => (
        <a 
          href={item.href}
          class="menu-item block px-4 py-3 border-2 border-black hover:bg-black hover:text-white transition-all group"
          style={`animation-delay: ${index * 0.05}s`}
        >
          <span class="flex items-center gap-3">
            <span class="text-xl">{item.icon}</span>
            <span class="font-bold uppercase text-sm tracking-wide">{item.label}</span>
            <span class="ml-auto opacity-0 group-hover:opacity-100 transition-opacity">▶</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  .menu-button {
    box-shadow: 4px 4px 0px rgba(0, 0, 0, 0.3);
    transition: all 0.1s;
  }

  .menu-button:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.3);
  }

  .menu-button:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0px rgba(0, 0, 0, 0.3);
  }

  .menu-items {
    animation: menuSlide 0.3s ease-out;
  }

  .menu-item {
    animation: menuItemAppear 0.3s ease-out backwards;
  }

  @keyframes menuSlide {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes menuItemAppear {
    from {
      opacity: 0;
      transform: translateX(10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Close menu when clicking outside */
  .peer:checked ~ .menu-items {
    display: block;
  }
</style>

<script>
  // Smooth scroll behavior
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
        // Close menu after clicking
        const menuToggle = document.getElementById('menu-toggle') as HTMLInputElement;
        if (menuToggle) menuToggle.checked = false;
      }
    });
  });
</script>
