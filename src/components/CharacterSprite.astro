---
interface Props {
  character: 'sunny' | 'aubrey' | 'kel' | 'basil' | 'hero' | 'mari' | 'omori';
  emotion?: 'neutral' | 'happy' | 'sad' | 'angry';
  size?: 'small' | 'medium' | 'large';
}

const { character, emotion = 'neutral', size = 'medium' } = Astro.props;

const sizeClasses = {
  small: 'w-16 h-16',
  medium: 'w-24 h-24',
  large: 'w-32 h-32'
};

// Character descriptions for accessibility and placeholders
const characterInfo = {
  sunny: { name: 'Sunny', emoji: '🌙', bgColor: 'bg-gray-800' },
  aubrey: { name: 'Aubrey', emoji: '💗', bgColor: 'bg-pink-300' },
  kel: { name: 'Kel', emoji: '🏀', bgColor: 'bg-orange-300' },
  basil: { name: 'Basil', emoji: '🌸', bgColor: 'bg-green-300' },
  hero: { name: 'Hero', emoji: '🍳', bgColor: 'bg-blue-300' },
  mari: { name: 'Mari', emoji: '🎹', bgColor: 'bg-purple-300' },
  omori: { name: 'Omori', emoji: '🔪', bgColor: 'bg-black text-white' }
};

const info = characterInfo[character];
---

<div class={`character-sprite ${sizeClasses[size]} relative group`}>
  <!-- Sketch-style character frame -->
  <div class={`w-full h-full border-4 border-black ${info.bgColor} flex items-center justify-center hand-drawn sketch-border relative overflow-hidden`}>
    <!-- Placeholder character representation -->
    <div class="text-4xl">{info.emoji}</div>
    
    <!-- Emotion indicator -->
    {emotion !== 'neutral' && (
      <div class="absolute top-0 right-0 w-3 h-3 rounded-full border-2 border-black"
           class:list={[
             emotion === 'happy' && 'bg-yellow-400',
             emotion === 'sad' && 'bg-blue-400',
             emotion === 'angry' && 'bg-red-400'
           ]}
      ></div>
    )}
  </div>
  
  <!-- Character name label -->
  <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 whitespace-nowrap">
    <span class="text-xs font-bold uppercase tracking-wider px-2 py-1 bg-white border-2 border-black">
      {info.name}
    </span>
  </div>
</div>

<style>
  .character-sprite {
    transition: transform 0.2s ease;
  }

  .character-sprite:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  .character-sprite:active {
    transform: scale(0.95);
  }

  /* Pixel-perfect rendering for character sprites */
  .character-sprite img {
    image-rendering: pixelated;
    image-rendering: -moz-crisp-edges;
    image-rendering: crisp-edges;
  }
</style>
