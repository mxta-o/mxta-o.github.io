---
interface Props {
  name: string;
  current: number;
  max: number;
  color?: 'heart' | 'juice' | 'energy';
}

const { name, current, max, color = 'energy' } = Astro.props;

const percentage = (current / max) * 100;

const colorClasses = {
  heart: 'bg-red-600',
  juice: 'bg-blue-600',
  energy: 'bg-black'
};
---

<div class="mb-4">
  <div class="flex justify-between mb-1">
    <span class="text-sm uppercase tracking-wider font-bold">{name}</span>
    <span class="text-sm font-mono">{current}/{max}</span>
  </div>
  <div class="energy-meter">
    <div 
      class={`energy-meter-fill ${colorClasses[color]}`}
      style={`width: ${percentage}%`}
    >
    </div>
  </div>
</div>
