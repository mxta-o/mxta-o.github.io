---
interface Props {
  name: string;
  role: string;
  imageSrc?: string;
}

const { name, role, imageSrc } = Astro.props;
---

<div class="portrait-frame bg-white border-4 border-black p-4 w-48 h-64 relative group hover:animate-wiggle">
  <div class="border-2 border-black h-full flex flex-col">
    {imageSrc ? (
      <div class="flex-1 bg-gray-200 border-b-2 border-black flex items-center justify-center overflow-hidden">
        <img src={imageSrc} alt={name} class="w-full h-full object-cover hand-drawn" />
      </div>
    ) : (
      <div class="flex-1 bg-gray-200 border-b-2 border-black flex items-center justify-center">
        <div class="text-6xl">👤</div>
      </div>
    )}
    <div class="p-2 text-center">
      <div class="font-bold text-sm uppercase tracking-wide">{name}</div>
      <div class="text-xs mt-1">{role}</div>
    </div>
  </div>
  
  <!-- HP/Energy bars at bottom -->
  <div class="absolute bottom-2 left-2 right-2 space-y-1">
    <div class="energy-meter h-2">
      <div class="energy-meter-fill bg-red-600" style="width: 100%"></div>
    </div>
    <div class="energy-meter h-2">
      <div class="energy-meter-fill bg-blue-600" style="width: 85%"></div>
    </div>
  </div>
</div>

<style>
  .portrait-frame {
    box-shadow: 6px 6px 0px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s;
  }

  .portrait-frame:hover {
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0px rgba(0, 0, 0, 0.3);
  }
</style>
