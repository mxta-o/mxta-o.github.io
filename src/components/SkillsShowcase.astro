---
interface Props {
  skills: { name: string; level: number; category: string }[];
}

const { skills } = Astro.props;

// Group skills by category
const groupedSkills = skills.reduce((acc, skill) => {
  if (!acc[skill.category]) {
    acc[skill.category] = [];
  }
  acc[skill.category].push(skill);
  return acc;
}, {} as Record<string, typeof skills>);
---

<div class="skills-showcase">
  {Object.entries(groupedSkills).map(([category, categorySkills]) => (
    <div class="skill-category mb-8">
      <h3 class="text-xl font-bold uppercase mb-4 border-b-3 border-black pb-2 flex items-center gap-2">
        <span class="text-2xl">▶</span>
        {category}
      </h3>
      
      <div class="space-y-4">
        {categorySkills.map((skill) => (
          <div class="skill-item">
            <div class="flex justify-between mb-2">
              <span class="font-mono uppercase text-sm">{skill.name}</span>
              <span class="font-mono text-sm">{skill.level}/100</span>
            </div>
            
            <!-- OMORI-style stat bar -->
            <div class="stat-bar">
              <div 
                class="stat-fill" 
                style={`width: ${skill.level}%`}
                data-level={skill.level}
              >
                <div class="stat-segments">
                  {Array.from({ length: Math.floor(skill.level / 10) }).map((_, i) => (
                    <div class="segment"></div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

<style>
  .stat-bar {
    background: white;
    border: 3px solid black;
    height: 24px;
    position: relative;
    box-shadow: inset 2px 2px 0px rgba(0, 0, 0, 0.2);
  }

  .stat-fill {
    background: black;
    height: 100%;
    transition: width 1s ease-out;
    position: relative;
    overflow: hidden;
  }

  .stat-segments {
    display: flex;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }

  .segment {
    flex: 1;
    border-right: 2px solid rgba(255, 255, 255, 0.3);
    min-width: 10%;
  }

  .segment:last-child {
    border-right: none;
  }

  /* Animation on scroll */
  .skill-item {
    animation: slideUp 0.6s ease-out;
  }

  .skill-item:hover .stat-fill {
    background: linear-gradient(90deg, black 0%, #333 50%, black 100%);
  }
</style>
