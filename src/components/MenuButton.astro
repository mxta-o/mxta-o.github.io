---
interface Props {
  label: string;
  selected?: boolean;
  variant?: 'fight' | 'run' | 'attack' | 'skill' | 'snack' | 'toy';
}

const { label, selected = false, variant = 'fight' } = Astro.props;

const variantColors = {
  fight: 'bg-red-500',
  run: 'bg-blue-500',
  attack: 'bg-yellow-500',
  skill: 'bg-cyan-500',
  snack: 'bg-orange-500',
  toy: 'bg-purple-500'
};
---

<button 
  class={`omori-button w-full ${selected ? 'bg-black text-white' : 'bg-white text-black'} relative group`}
>
  <div class={`absolute top-0 left-0 w-2 h-full ${variantColors[variant]}`}></div>
  <span class="ml-4 block text-left uppercase tracking-wide">{label}</span>
  {selected && <span class="absolute right-4 top-1/2 -translate-y-1/2">▶</span>}
</button>

<style>
  button {
    transition: all 0.1s ease;
  }

  button:hover {
    transform: translateX(4px);
  }
</style>
